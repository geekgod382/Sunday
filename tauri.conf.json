{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sunday",
  "version": "0.1.0",
  "identifier": "com.sunday.assistant",
  "build": {
    "frontendDist": "./frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sunday",
        "width": 400,
        "height": 300,
        "minWidth": 200,
        "minHeight": 80,
        "center": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security":{
      "capabilities": ["com.sunday.assistant.capability"]
    }
  }
}
